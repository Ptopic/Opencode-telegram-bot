{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-openagent.schema.json",
  "mcp": {
    "code-search": {
      "type": "local",
      "command": [
        "node",
        "/Users/petartopic/Desktop/Petar/Opencode-telegram-bot/packages/mcp-server/dist/index.js"
      ],
      "environment": {
        "CODE_SEARCH_API_URL": "http://localhost:4098"
      },
      "enabled": true
    }
  },
  "agents": {
    "sisyphus": {
      "tools": {
        "ast_grep_search": false,
        "ast_grep_replace": false,
        "MiniMax_web_search": false,
        "webfetch": false,
        "web-search-prime_web_search_prime": false,
        "websearch_web_search_exa": false
      },
      "permission": {
        "ast_grep_search": "deny",
        "ast_grep_replace": "deny",
        "MiniMax_web_search": "deny",
        "webfetch": "deny",
        "web-search-prime_web_search_prime": "deny",
        "websearch_web_search_exa": "deny",
        "bash": {
          "*": "ask",
          "bx": "allow",
          "bx *": "allow"
        }
      },
      "prompt_append": "\n## Tool policy\nYou MUST use code_search first for code discovery. Only after code_search returns exact file paths or results may you use grep or rg to narrow to a specific section. Do NOT use glob, find, fd, ls, cat, sed, awk, bash search, ast_grep_search, ast_grep_replace, or similar tools for initial discovery. When delegating tasks to subagents, instruct them to follow the same code_search-first workflow.\n\n## Code-Search Tools (USE THESE)\n- code_search - Semantic code search using natural language queries\n- code_search_code_search - Find code by meaning, not just exact matches\n- code_search_code_graph_search - Graph-based code search\n- code_search_code_graph_context - Get detailed context for a graph node\n- code_search_code_graph_callers - Find all functions that call a specific function\n- code_search_code_graph_callees - Find all functions called by a specific function\n- code_search_code_index - Index code paths for search\n- code_search_code_stats - Get statistics about the code index\n- code_search_code_remove_index - Remove a path from the index\n- code_search_code_watch_start - Start watching paths for changes\n- code_search_code_watch_stop - Stop watching paths\n- code_search_code_dead_code - Find potentially dead code\n- read - Read file contents (use after code-search finds exact file paths)\n- grep / rg - only use after code_search returns exact file paths or results, for narrowing to a specific section\n\n## PROHIBITED TOOLS (NEVER use — blocked at config level)\n- ast_grep_search, ast_grep_replace - use code_search instead\n- MiniMax_web_search, webfetch, web-search-prime, websearch_web_search_exa - use bx skill instead\n\n## Web Search Policy (MANDATORY)\n- For ALL web searches, you MUST use the `bx` command (Brave Search CLI) via the `bx` skill.\n- NEVER use MiniMax web search (MiniMax_web_search), webfetch, web-search-prime_web_search_prime, websearch_web_search_exa, or any other web search tool.\n- The ONLY permitted web search method is `bx` — use `bx \"query\"` for RAG/grounding, `bx answers \"query\"` for synthesized answers, `bx web \"query\"` for traditional search results, `bx news \"query\"` for news, etc.\n- Bash is restricted to `bx` commands only. Do not use bash for any non-`bx` command.\n- If you need to search the web, invoke the bx skill and use it. No other web search tool is allowed.\n- When delegating to subagents, instruct them to also use only bx for web search. Never allow subagents to use MiniMax web search, webfetch, or any other non-Brave search tool.\n ",
      "model": "synthetic/hf:moonshotai/Kimi-K2.6"
    },
    "ultrawork": {
      "tools": {
        "ast_grep_search": false,
        "ast_grep_replace": false,
        "MiniMax_web_search": false,
        "webfetch": false,
        "web-search-prime_web_search_prime": false,
        "websearch_web_search_exa": false
      },
      "permission": {
