{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-openagent.schema.json",

  // NOTE: models, tools, permission, skills, and prompt_append are defined in
  // --help/config.mjs and merged by `opencode-telegram prompt`. Do NOT add them here.

  "mcp": {
    "code-search": {
      "type": "local",
      "command": [
        "node",
        "/Users/petartopic/Desktop/Petar/Opencode-telegram-bot/packages/mcp-server/dist/index.js",
      ],
      "environment": {
        "CODE_SEARCH_API_URL": "http://localhost:4098",
      },
      "enabled": true,
    },
  },

  "agents": {
    "sisyphus": {},
    "ultrawork": {},
    "explore": {},
    "general": {},
    "oracle": {},
