{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-openagent.schema.json",

  // NOTE: models, tools, permission, skills, and prompt_append are defined in
  // --help/config.mjs and merged by `opencode-telegram prompt`. Do NOT add them here.

  "mcp": {
    "code-search": {
      "type": "local",
      "command": [
        "node",
        "/Users/petartopic/Desktop/Petar/Opencode-telegram-bot/packages/mcp-server/dist/index.js",
      ],
      "environment": {
        "CODE_SEARCH_API_URL": "http://localhost:4098",
      },
      "enabled": true,
    },
  },

  "agents": {
    "sisyphus": {},
    "ultrawork": {},
    "explore": {},
    "general": {},
    "oracle": {},
    "librarian": {},
    "prometheus": {},
    "metis": {},
    "atlas": {},
    "sisyphus-junior": {},
    "momus": {},
    "hephaestus": {},
    "multimodal-looker": {},
    "reviewer": {},
  },

  "categories": {
    "visual-engineering": {},
    "ultrabrain": {},
    "deep": {},
    "artistry": {},
    "quick": {},
    "unspecified-low": {},
    "unspecified-high": {},
    "writing": {},
  },

  "skills": {
    "code-search": {
      "description": "Semantic code search using vector embeddings, BM25, and knowledge graph. Use this skill when you need to find code by meaning, not just exact matches.",
      "instructions": "Always use code-search tools for ALL code discovery. Use code-search_code_search for natural language queries. Use code-search_code_graph_* for dependency analysis. NEVER use grep, ripgrep, rg, glob, find, ls, cat, bash, or any shell-based search.",
      "tools": {
        "code-search_*": true,
        "read": true,
      },
      "mcp_servers": {
        "code-search": {
          "command": "node",
          "args": [
            "/Users/petartopic/Desktop/Petar/Opencode-telegram-bot/packages/mcp-server/dist/index.js",
          ],
          "env": {
            "CODE_SEARCH_API_URL": "http://localhost:4098",
          },
        },
      },
    },

    "deep-code-review": {
      "description": "Perform a thorough, structured code review of a codebase, diff, or PR. Covers correctness, security (OWASP), performance, maintainability, and style. Use when asked to review code, check a PR, audit changes, or analyze code quality.",
      "instructions": "file://--help/.opencode/skills/deep-code-review/SKILL.md",
      "tools": {
        "code-search_*": true,
        "read": true,
        "bash": true,
        "edit": true,
        "write": true,
        "todowrite": true,
      },
      "mcp_servers": {
        "code-search": {
          "command": "node",
          "args": [
            "/Users/petartopic/Desktop/Petar/Opencode-telegram-bot/packages/mcp-server/dist/index.js",
          ],
          "env": {
            "CODE_SEARCH_API_URL": "http://localhost:4098",
          },
        },
      },
    },
  },
}
